#!/usr/bin/env sh

# Git on Windows can launch hooks with a reduced PATH, so ensure the Node toolchain
# is visible before running pnpm-based checks.
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*)
    export PATH="/c/Program Files/nodejs:/c/Users/abhishek/AppData/Roaming/npm:$PATH"
    ;;
esac

pnpm exec lint-staged
pnpm typecheck
pnpm test