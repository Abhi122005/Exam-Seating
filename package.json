{
  "name": "exam-seating-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:all": "pnpm -r --parallel dev",
    "dev:parser": "pnpm --filter parser dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "eslint apps/web",
    "lint:python": "pnpm --filter parser lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:python": "pnpm --filter parser format",
    "format:check:python": "pnpm --filter parser format:check",
    "test": "pnpm --filter web test",
    "typecheck": "pnpm --filter web exec tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6"
  }
}
